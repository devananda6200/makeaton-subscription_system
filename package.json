{
  "name": "brightloop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The subscription operating system for growing businesses",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test --test-concurrency=1 server/tests/*.test.mjs",
    "test:e2e": "playwright test",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "lucide-react": "^1.65.0",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
