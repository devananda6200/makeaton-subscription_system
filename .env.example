PORT=3001
APP_URL=http://localhost:5173
DATABASE_PATH=./data/brightloop.db
# Seed fictional accounts and business records. Never enable on a real deployment.
DEMO_MODE=true
# Optional email transport. Without SMTP, email stays in the admin outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Brightloop <billing@example.com>
# Production: NODE_ENV=production, APP_URL=https://your-host, DEMO_MODE=false
# First production boot requires ADMIN_EMAIL and ADMIN_PASSWORD (9+ chars, A-z, symbol).
ADMIN_EMAIL=
ADMIN_PASSWORD=
